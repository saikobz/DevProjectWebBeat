# Copy to `.env.local` for local development (see README).

NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=

# Optional: external audio worker / voice tag pipeline
FFMPEG_WORKER_URL=
VOICE_TAG_SOURCE_PATH=public/voice-tags/default-tag.wav

OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
OMISE_WEBHOOK_SECRET=

RESEND_API_KEY=
EMAIL_FROM=

# Optional: Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: Sentry — runtime (DSN)
SENTRY_DSN=
# Optional: Sentry — source maps at build time (CI/Vercel: org + project slugs from sentry.io, not display names)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional: Sentry browser (defaults to server DSN if unset in sentry.client.config)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_TRACES_SAMPLE_RATE=0.05

# Playwright: base URL / skip auto webServer (when dev server already running)
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_SKIP_WEBSERVER=
